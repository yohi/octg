{
  "name": "octg-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/admin/*"]
  },
  // Deno tokenizer is enabled for this production deployment. Keep its auth
  // token in the separately managed Worker secret.
  "vars": {
    "QUOTA_LIMIT_STANDARD": "1000000",
    "QUOTA_LIMIT_MINI": "9950000",
    "MAX_INPUT_BYTES": "1048576",
    "DENO_TOKENIZER_ENDPOINT": "https://octg.yohi.deno.net/tokenize",
    "DENO_TOKENIZER_THRESHOLD_BYTES": "262144",
    "DENO_TOKENIZER_TIMEOUT_MS": "5000",
    "MAX_IN_FLIGHT_REQUESTS": "2",
    "IN_FLIGHT_LEASE_TTL_MS": "120000",
    "IN_FLIGHT_LEASE_RENEWAL_MS": "30000",
    "OCTG_UPSTREAM_BASE_URL": "https://gateway.ai.cloudflare.com/v1/4bc6b4d26ae21d2b0d5bbb7ce91f1cda/octg-gateway/openai",
    "ACCESS_TEAM_DOMAIN": "https://yohi.cloudflareaccess.com",
    "ACCESS_AUD": "d261bb3efaea8adc0fb32db48b86c855212c9ddde60ab90de13aa7062ed77abf",
  },
  "durable_objects": {
    "bindings": [
      { "name": "QUOTA_CONTROLLER", "class_name": "QuotaController" },
      { "name": "TOKENIZER_CONTROLLER", "class_name": "TokenizerController" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["QuotaController"] },
    { "tag": "v2", "new_sqlite_classes": ["TokenizerController"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "octg",
      "database_id": "42ffaeac-6bc2-431b-a5c1-a8016fae8b4f",
      "migrations_dir": "../../db/migrations"
    }
  ],
  "triggers": { "crons": ["5 0 * * *"] }
}
