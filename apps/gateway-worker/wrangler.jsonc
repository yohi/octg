{
  "name": "octg-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "QUOTA_LIMIT_STANDARD": "1000000",
    "QUOTA_LIMIT_MINI": "10000000",
    "OCTG_UPSTREAM_BASE_URL": "https://gateway.ai.cloudflare.com/v1/4bc6b4d26ae21d2b0d5bbb7ce91f1cda/octg-gateway/openai",
    "ACCESS_TEAM_DOMAIN": "yohi.cloudflareaccess.com",
    "ACCESS_AUD": "d261bb3efaea8adc0fb32db48b86c855212c9ddde60ab90de13aa7062ed77abf",
    "ACCESS_ALLOWED_SERVICE_TOKEN_IDS": ""
  },
  "durable_objects": {
    "bindings": [{ "name": "QUOTA_CONTROLLER", "class_name": "QuotaController" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuotaController"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "octg",
      "database_id": "42ffaeac-6bc2-431b-a5c1-a8016fae8b4f",
      "migrations_dir": "../../db/migrations"
    }
  ],
  "triggers": { "crons": ["5 0 * * *"] }
}
