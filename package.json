{
  "name": "octg",
  "private": true,
  "workspaces": ["apps/*", "durable-objects/*", "packages/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:ci-smoke": "bash scripts/ci-smoke-test.test.sh",
    "test:deno-deploy-workflow": "bash scripts/deno-deploy-workflow.test.sh && node --test scripts/deno-deploy-failure-diagnostics.test.mjs",
    "test:preview-workflow": "bash scripts/preview-workflow.test.sh && node scripts/preview-d1-resolver.test.mjs && node scripts/preview-quota-validator.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed:client": "node scripts/seed-client.mjs",
    "seed:client:remote": "node scripts/seed-client-remote.mjs",
    "setup:local": "node scripts/setup.mjs local",
    "setup:deploy": "node scripts/setup.mjs deploy"
  },
  "devDependencies": { "typescript": "^5.6.0" }
}
