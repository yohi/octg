# このファイルを .env.preview にコピーして実値を入力してください。
# .env.preview は .gitignore 対象で、スクリプト実行時に chmod 600 へ変更されます。

CLOUDFLARE_PREVIEW_ACCOUNT_ID="<preview-account-id>"
CLOUDFLARE_PREVIEW_API_TOKEN="<preview-api-token>"

# 空欄のまま通常実行すると同名D1を検索し、存在しなければ作成後にIDを尋ねます。
# --dry-runではCloudflareへ接続しないため、IDを入力してください。
OCTG_PREVIEW_DATABASE_ID=""
OCTG_PREVIEW_DATABASE_NAME="octg-gateway-preview-db"
OCTG_PREVIEW_WORKER_NAME="octg-gateway-preview"
OCTG_PREVIEW_UPSTREAM_BASE_URL="https://<preview-upstream-url>"
OCTG_PREVIEW_BASE_URL="https://<preview-worker-host>"
OCTG_PREVIEW_QUOTA_LIMIT_STANDARD="0"
OCTG_PREVIEW_QUOTA_LIMIT_MINI="100000"

# Preview D1へ登録し、--github時にGitHub Environment Secretへ設定します。
OCTG_PREVIEW_CLIENT_ID="client_ci_smoke"
OCTG_PREVIEW_CLIENT_NAME="CI Smoke"
OCTG_PREVIEW_CLIENT_KEY="octg_sk_<preview-client-key>"

# Preview Workerへ登録済みのpepperを入力します。Productionの値は使用しません。
OCTG_KEY_PEPPER="<preview-key-pepper>"

# --githubを使う場合だけ入力します。
GITHUB_REPOSITORY="<owner/repository>"
SMOKE_MODEL="gpt-5-mini"
