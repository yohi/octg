# OCTG environment template
# Copy this file to .env, set only the values needed for the target, and keep
# the copy private: chmod 600 .env
#
# Values with <...> are documentation placeholders. Never deploy them.
# Production and Preview values are intentionally prefixed/separated.

# -----------------------------------------------------------------------------
# LOCAL: consumed by `npm run setup:local`
# No input is required for the default local setup. These values are optional.
# -----------------------------------------------------------------------------
OCTG_LOCAL_KEY_PEPPER=dev-pepper
OCTG_LOCAL_UPSTREAM_BASE_URL=https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_id>/openai
OCTG_LOCAL_UPSTREAM_API_TOKEN=dev-token
OCTG_LOCAL_OPENAI_USAGE_API_KEY=dev-usage-key
OCTG_LOCAL_CLIENT_ID=client_demo
OCTG_LOCAL_CLIENT_NAME=Demo
# Leave empty to generate a local key once during setup.
OCTG_LOCAL_CLIENT_KEY=
OCTG_LOCAL_CLIENT_TOOLS_MODE=REJECT

# -----------------------------------------------------------------------------
# PRODUCTION: consumed by `npm run setup:deploy`
# Existing D1, Gateway B, and Access resources are required beforehand.
# Account ID/API token may also be supplied by the authenticated Wrangler env.
# -----------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=<production-account-id>
CLOUDFLARE_API_TOKEN=<production-wrangler-token>
OCTG_DATABASE_ID=<production-d1-database-id>
OCTG_UPSTREAM_BASE_URL=https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_b_id>/openai
ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
ACCESS_AUD=<access-application-audience-tag>

# Worker Secrets. Keep these out of committed files and provide them through a
# secret manager or the setup prompt. OCTG_KEY_PEPPER must match seeded clients.
OCTG_KEY_PEPPER=<production-key-pepper>
OCTG_UPSTREAM_API_TOKEN=<gateway-b-run-token>
OPENAI_USAGE_API_KEY=<openai-usage-read-token>

# -----------------------------------------------------------------------------
# PREVIEW: consumed by `zsh scripts/setup-preview.zsh`
# Use a Preview account, Worker, D1, client, and pepper. Never reuse Production.
# -----------------------------------------------------------------------------
CLOUDFLARE_PREVIEW_ACCOUNT_ID=<preview-account-id>
CLOUDFLARE_PREVIEW_API_TOKEN=<preview-resource-token>
OCTG_PREVIEW_UPSTREAM_API_TOKEN=<preview-gateway-b-run-token>
OCTG_PREVIEW_DATABASE_ID=<preview-d1-database-id>
OCTG_PREVIEW_DATABASE_NAME=octg-gateway-preview-db
OCTG_PREVIEW_WORKER_NAME=octg-gateway-preview
OCTG_PREVIEW_UPSTREAM_BASE_URL=https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_b_id>/openai
OCTG_PREVIEW_BASE_URL=https://<preview-worker-host>
OCTG_PREVIEW_QUOTA_LIMIT_STANDARD=0
OCTG_PREVIEW_QUOTA_LIMIT_MINI=100000
OCTG_PREVIEW_CLIENT_ID=client_ci_smoke
OCTG_PREVIEW_CLIENT_NAME=CI Smoke
OCTG_PREVIEW_CLIENT_KEY=<preview-client-key>
OCTG_PREVIEW_KEY_PEPPER=<preview-key-pepper>
GITHUB_REPOSITORY=<owner/repository>
SMOKE_MODEL=gpt-5-mini

# -----------------------------------------------------------------------------
# DENO TOKENIZER: configure Deno Deploy and the matching Worker independently.
# -----------------------------------------------------------------------------
DENO_DEPLOY_ORG=<deno-organization>
DENO_DEPLOY_APP=<deno-app>
DENO_DEPLOY_TOKEN=<deno-deploy-token>
DENO_TOKENIZER_ENDPOINT=https://<deno-project>.deno.dev/tokenize
DENO_TOKENIZER_AUTH_TOKEN=<deno-shared-auth-token>
DENO_TOKENIZER_THRESHOLD_BYTES=<measured-positive-integer>
DENO_TOKENIZER_TIMEOUT_MS=<measured-positive-integer>

# -----------------------------------------------------------------------------
# WORKER CANARY: consumed by `npm run canary:worker -- --env-file=.env`
# Use a dedicated Production client key. The canary consumes Production quota.
# -----------------------------------------------------------------------------
OCTG_CANARY_URL=https://<production-worker-host>/v1/chat/completions
OCTG_CANARY_ALLOWED_HOSTS=<production-worker-host>
OCTG_CANARY_CLIENT_KEY=<production-canary-client-key>
CANARY_PAYLOAD_PATH=
CANARY_CONCURRENCY=1,2
CANARY_REQUEST_TIMEOUT_MS=120000

# -----------------------------------------------------------------------------
# OPENCODE CLIENT: Gateway A Custom Provider values, not Worker Gateway B.
# -----------------------------------------------------------------------------
OCTG_CF_ACCOUNT_ID=<gateway-a-account-id>
OCTG_CF_GATEWAY_ID=<gateway-a-id>
OCTG_CF_API_TOKEN=<gateway-a-run-token>
