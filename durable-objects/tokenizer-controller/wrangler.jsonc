{
  "name": "octg-tokenizer-controller",
  "main": "src/tokenizer-controller.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": {
    "bindings": [{ "name": "TOKENIZER_CONTROLLER", "class_name": "TokenizerController" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TokenizerController"] }]
}
